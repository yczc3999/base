generator client {
  provider = "prisma-client"
  output   = "../src/models/generated"
}

datasource db {
  provider = "postgresql"
}

/// 管理员用户表
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  password     String   @db.VarChar(255)
  nickname     String?  @db.VarChar(50)
  avatar       String?  @db.VarChar(255)
  email        String?  @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  status       Int      @default(1) @db.SmallInt /// 1=正常 0=禁用
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  tokenVersion Int      @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?  @db.VarChar(50) @map("last_login_ip")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

/// 前端用户表
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  password     String   @db.VarChar(255)
  nickname     String?  @db.VarChar(50)
  avatar       String?  @db.VarChar(255)
  email        String?  @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  status       Int      @default(1) @db.SmallInt /// 1=正常 0=禁用
  tokenVersion Int      @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?  @db.VarChar(50) @map("last_login_ip")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// 系统配置表
model Setting {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  label     String?  @db.VarChar(100)
  value     String   @db.Text
  remark    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, name])
  @@map("settings")
}

/// 管理员操作日志表
model AdminOperationLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")           /// 操作人 ID
  username   String   @db.VarChar(50)            /// 操作人用户名（冗余，方便查询）
  module     String   @db.VarChar(100)           /// 操作模块（Controller 名称）
  action     String   @db.VarChar(100)           /// 操作方法（如 doEdit、doDelete）
  method     String   @db.VarChar(10)            /// HTTP 方法（GET/POST/PUT/DELETE）
  url        String   @db.VarChar(500)           /// 请求 URL
  params     String?  @db.Text                   /// 请求参数（JSON）
  ip         String?  @db.VarChar(50)            /// 请求 IP
  userAgent  String?  @db.VarChar(500) @map("user_agent")
  statusCode Int      @default(0) @map("status_code") /// 响应业务码
  duration   Int      @default(0)                /// 耗时（ms）
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("admin_operation_logs")
}

/// 管理员登录日志表
model AdminLoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  username  String   @db.VarChar(50)
  ip        String?  @db.VarChar(50)
  userAgent String?  @db.VarChar(500) @map("user_agent")
  status    Int      @default(1) @db.SmallInt    /// 1=成功 0=失败
  remark    String?  @db.VarChar(255)            /// 失败原因等
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("admin_login_logs")
}
