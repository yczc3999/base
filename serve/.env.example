# ===========================
# 应用配置
# ===========================
APP_NAME=base
APP_URL=http://localhost:3000
APP_KEY=
APP_DEBUG=false

# ===========================
# 服务配置
# ===========================
PORT=3000
# uvicorn 工作进程数（0=自动取 CPU 核心数）
WORKERS=0

# ===========================
# PostgreSQL 数据库
# ===========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Base 仓库本身的唯一数据库身份；下游 Fork/Clone 必须改成项目专属库/角色。
DATABASE_NAME=base_platform
DATABASE_USER=base_platform_app
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===========================
# Redis 缓存
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# Token 认证
# ===========================
# access_token 有效期（秒，默认 2 小时）
TOKEN_EXPIRES_IN=7200
# refresh_token 有效期（秒，默认 7 天）
REFRESH_TOKEN_EXPIRES_IN=604800
