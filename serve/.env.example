# ===========================
# 应用配置
# ===========================
APP_NAME=base
APP_URL=http://localhost:3000
APP_KEY=
APP_DEBUG=false

# ===========================
# 服务配置
# ===========================
PORT=3000
# uvicorn 工作进程数（0=自动取 CPU 核心数）
WORKERS=0

# ===========================
# PostgreSQL 数据库
# ===========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=base
DATABASE_USER=base_user
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

# ---- V2 连接池全局参数（performance-cache-database-design.md §8.3）----
# PostgreSQL 实例 max_connections
DB_MAX_CONNECTIONS=100
# 管理/迁移/告警保留连接数（连接预算上限 = DB_MAX_CONNECTIONS - 该值）
DB_ADMIN_RESERVED_CONNECTIONS=20
# 连接健康检查 / 取连接超时 / 回收周期
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT_S=3
DB_POOL_RECYCLE_S=1800
# 所有连接统一下发的 lock / idle-in-transaction 超时（秒，下发为毫秒）
DB_LOCK_TIMEOUT_S=1
DB_IDLE_IN_TX_TIMEOUT_S=5

# ---- V2 分进程连接池 profile（pool_size / max_overflow / statement_timeout_s）----
# api-admin（后台读模型）：2s statement
DB_API_POOL_SIZE=5
DB_API_POOL_OVERFLOW=2
DB_API_STMT_TIMEOUT_S=2
# market-ingest（行情热路径）：5s
DB_MARKET_POOL_SIZE=8
DB_MARKET_POOL_OVERFLOW=2
DB_MARKET_STMT_TIMEOUT_S=5
# execution（下单/心跳）：5s
DB_EXECUTION_POOL_SIZE=5
DB_EXECUTION_POOL_OVERFLOW=1
DB_EXECUTION_STMT_TIMEOUT_S=5
# cognition（研究/AI）：5s
DB_COGNITION_POOL_SIZE=3
DB_COGNITION_POOL_OVERFLOW=2
DB_COGNITION_STMT_TIMEOUT_S=5
# evaluation（标签/指标/归档）：30s batch
DB_EVALUATION_POOL_SIZE=3
DB_EVALUATION_POOL_OVERFLOW=1
DB_EVALUATION_STMT_TIMEOUT_S=30
# replay（回放，默认并发 2）：30s batch
DB_REPLAY_POOL_SIZE=2
DB_REPLAY_POOL_OVERFLOW=1
DB_REPLAY_STMT_TIMEOUT_S=30

# ---- V2 密钥：只保存 secret_ref + version，凭据由 vault 解密 ----
# 禁止在此写入真实 API key / passphrase / 私钥。
# 示例（按服务替换，vault 实现见 WP-05）：
# POLYMARKET_L1_SECRET_REF=vault://polymarket/l1-creds/v1
# POLYMARKET_L2_SECRET_REF=vault://polymarket/l2-creds/v1

# ---- V2 namespace（键前缀：pm:{schema_version}:{env}:{role}）----
REDIS_ENV=prod
REDIS_SCHEMA_VERSION=v2

# ---- V2 Control Redis（fail-closed：故障禁止增仓）----
# 独立连接池 + 独立 namespace（pm:v2:{env}:control）；默认 DB 0
# 可用 REDIS_CONTROL_URL 整体覆盖 host/port/db/password
REDIS_CONTROL_URL=
REDIS_CONTROL_HOST=localhost
REDIS_CONTROL_PORT=6379
REDIS_CONTROL_DB=0
REDIS_CONTROL_PASSWORD=
REDIS_CONTROL_MAX_CONNECTIONS=20
REDIS_CONTROL_CONNECT_TIMEOUT_S=2
REDIS_CONTROL_READ_TIMEOUT_S=2
REDIS_CONTROL_HEALTH_CHECK_INTERVAL_S=30

# ---- V2 Cache Redis（可丢：故障只降级不改变业务判断）----
# 独立连接池 + 独立 namespace（pm:v2:{env}:cache）；默认 DB 1
REDIS_CACHE_URL=
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1
REDIS_CACHE_PASSWORD=
REDIS_CACHE_MAX_CONNECTIONS=20
REDIS_CACHE_CONNECT_TIMEOUT_S=2
REDIS_CACHE_READ_TIMEOUT_S=2
REDIS_CACHE_HEALTH_CHECK_INTERVAL_S=30
# 强制有限 TTL（秒）+ 抖动上限；永久 TTL 禁止
REDIS_CACHE_TTL_S=300
REDIS_CACHE_TTL_JITTER_S=30
# 连接故障时吞错降级（get→None、写→False）
REDIS_CACHE_BYPASS_ON_ERROR=true

# ===========================
# V2 Artifact Store
# ===========================
# 存储驱动（local | s3；s3 见 WP-00c2）
ARTIFACT_DRIVER=local
# 本地 driver 根目录（仅开发/测试/有界 spool）
ARTIFACT_LOCAL_ROOT=./storage/v2-artifacts
# 低于该字节数的小 payload 可内联（BYTEA / 对象存储由上层决定）
ARTIFACT_INLINE_THRESHOLD_BYTES=16384
# 超过该字节数且 zstd 后更小才启用压缩
ARTIFACT_COMPRESSION_THRESHOLD_BYTES=16384
# zstd 压缩级别（zstandard 库安全范围）
ARTIFACT_ZSTD_LEVEL=6
# 对象硬上限（防压缩炸弹；读取时也校验）
ARTIFACT_MAX_OBJECT_BYTES=67108864
# 读取/verify 时校验 SHA 与 size
ARTIFACT_VERIFY_ON_READ=true

# ===========================
# Redis 缓存（Base legacy）
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# Token 认证
# ===========================
# access_token 有效期（秒，默认 2 小时）
TOKEN_EXPIRES_IN=7200
# refresh_token 有效期（秒，默认 7 天）
REFRESH_TOKEN_EXPIRES_IN=604800
