# ===========================
# 应用配置
# ===========================
APP_NAME=base
APP_URL=http://localhost:3000
APP_KEY=
APP_DEBUG=false

# ===========================
# 服务配置
# ===========================
PORT=3000
# uvicorn 工作进程数（0=自动取 CPU 核心数）
WORKERS=0

# ===========================
# PostgreSQL 数据库
# ===========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=base
DATABASE_USER=base_user
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

# ---- V2 连接池全局参数（performance-cache-database-design.md §8.3）----
# PostgreSQL 实例 max_connections
DB_MAX_CONNECTIONS=100
# 管理/迁移/告警保留连接数（连接预算上限 = DB_MAX_CONNECTIONS - 该值）
DB_ADMIN_RESERVED_CONNECTIONS=20
# 连接健康检查 / 取连接超时 / 回收周期
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT_S=3
DB_POOL_RECYCLE_S=1800
# 所有连接统一下发的 lock / idle-in-transaction 超时（秒，下发为毫秒）
DB_LOCK_TIMEOUT_S=1
DB_IDLE_IN_TX_TIMEOUT_S=5

# ---- V2 分进程连接池 profile（pool_size / max_overflow / statement_timeout_s）----
# api-admin（后台读模型）：2s statement
DB_API_POOL_SIZE=24
DB_API_POOL_OVERFLOW=8
DB_API_STMT_TIMEOUT_S=2
# market-ingest（行情热路径）：5s
DB_MARKET_POOL_SIZE=8
DB_MARKET_POOL_OVERFLOW=2
DB_MARKET_STMT_TIMEOUT_S=5
# execution（下单/心跳）：5s
DB_EXECUTION_POOL_SIZE=5
DB_EXECUTION_POOL_OVERFLOW=1
DB_EXECUTION_STMT_TIMEOUT_S=5
# cognition（研究/AI）：5s
DB_COGNITION_POOL_SIZE=3
DB_COGNITION_POOL_OVERFLOW=2
DB_COGNITION_STMT_TIMEOUT_S=5
# evaluation（标签/指标/归档）：30s batch
DB_EVALUATION_POOL_SIZE=3
DB_EVALUATION_POOL_OVERFLOW=1
DB_EVALUATION_STMT_TIMEOUT_S=30
# replay（回放，默认并发 2）：30s batch
DB_REPLAY_POOL_SIZE=2
DB_REPLAY_POOL_OVERFLOW=1
DB_REPLAY_STMT_TIMEOUT_S=30
# reconciliation（订单/账本/链对账，WP-07C）：30s batch
DB_RECONCILIATION_POOL_SIZE=2
DB_RECONCILIATION_POOL_OVERFLOW=1
DB_RECONCILIATION_STMT_TIMEOUT_S=30
# outbox（发布/清扫/消费，WP-07C）：30s batch
DB_OUTBOX_POOL_SIZE=2
DB_OUTBOX_POOL_OVERFLOW=1
DB_OUTBOX_STMT_TIMEOUT_S=30

# ---- V2 密钥：只保存 secret_ref + version，凭据由 vault 解密 ----
# 禁止在此写入真实 API key / passphrase / 私钥。
# 示例（按服务替换，vault 实现见 WP-05）：
# POLYMARKET_L1_SECRET_REF=vault://polymarket/l1-creds/v1
# POLYMARKET_L2_SECRET_REF=vault://polymarket/l2-creds/v1

# ---- V2 Vault（WP-05）：只保存 keyring/secret 引用，绝不保存 key 明文 ----
# keyring 引用形如 env://<ENV_VAR_NAME> / file://<path> / KMS ARN；master key bytes 由
# 调用方从该引用加载。示例值不是真实 key，仅示意引用语法：
# 注意：PM_V2_VAULT_KEYRING_REF 是后台「运行时配置」写入模型 API key 的前置条件——
# 未配置/不可用时后台写接口 fail closed（503），读路径回退下方 env 兜底。
PM_V2_VAULT_KEYRING_REF=env://PM_V2_VAULT_MASTER_KEY_REF
# AAD 绑定的环境名（dev/staging/prod）
PM_V2_VAULT_ENV=dev
# 执行 egress 模式：WP-05 只允许 shadow（fake transport）；真实 provider 激活被阻塞
PM_V2_EXECUTION_EGRESS_MODE=shadow

# ---- V2 模型 API key（env 兜底；可在后台「运行时配置」管理，DB vault 优先）----
# 以下 4 个变量仅是 env 兜底：后台配置（经 vault 信封加密落库）生效后覆盖它们；
# 本文件绝不填写真实 key。
# PM_V2_DEEPSEEK_API_KEY=
# PM_V2_XAI_API_KEY=
# PM_V2_KIMI_API_KEY=
# PM_V2_PACKY_API_KEY=

# ---- V2 Provider endpoint / timeout（WP-05 fake-only）----
# 真实 provider 基址留空；激活前必须由部署显式注入（fake-only 下保持空）
PM_V2_PROVIDER_BASE_URL=
PM_V2_PROVIDER_CONNECT_TIMEOUT_S=2
PM_V2_PROVIDER_READ_TIMEOUT_S=10
PM_V2_PROVIDER_MAX_ATTEMPTS=3
# /v1/heartbeats 调度间隔（秒）+ 最大漂移（毫秒）
PM_V2_HEARTBEAT_INTERVAL_S=5
PM_V2_HEARTBEAT_DRIFT_MS=500

# ---- V2 namespace（键前缀：pm:{schema_version}:{env}:{role}）----
REDIS_ENV=prod
REDIS_SCHEMA_VERSION=v2

# ---- V2 Control Redis（fail-closed：故障禁止增仓）----
# 独立连接池 + 独立 namespace（pm:v2:{env}:control）；默认 DB 0
# 可用 REDIS_CONTROL_URL 整体覆盖 host/port/db/password
REDIS_CONTROL_URL=
REDIS_CONTROL_HOST=localhost
REDIS_CONTROL_PORT=6379
REDIS_CONTROL_DB=0
REDIS_CONTROL_PASSWORD=
REDIS_CONTROL_MAX_CONNECTIONS=20
REDIS_CONTROL_CONNECT_TIMEOUT_S=2
REDIS_CONTROL_READ_TIMEOUT_S=2
REDIS_CONTROL_HEALTH_CHECK_INTERVAL_S=30

# ---- V2 Cache Redis（可丢：故障只降级不改变业务判断）----
# 独立连接池 + 独立 namespace（pm:v2:{env}:cache）；默认 DB 1
REDIS_CACHE_URL=
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1
REDIS_CACHE_PASSWORD=
REDIS_CACHE_MAX_CONNECTIONS=20
REDIS_CACHE_CONNECT_TIMEOUT_S=2
REDIS_CACHE_READ_TIMEOUT_S=2
REDIS_CACHE_HEALTH_CHECK_INTERVAL_S=30
# 强制有限 TTL（秒）+ 抖动上限；永久 TTL 禁止
REDIS_CACHE_TTL_S=300
REDIS_CACHE_TTL_JITTER_S=30
# 连接故障时吞错降级（get→None、写→False）
REDIS_CACHE_BYPASS_ON_ERROR=true

# ===========================
# V2 Artifact Store
# ===========================
# 存储驱动（local | s3；s3 见 WP-00c2）
ARTIFACT_DRIVER=local
# 本地 driver 根目录（仅开发/测试/有界 spool）
ARTIFACT_LOCAL_ROOT=./storage/v2-artifacts
# 低于该字节数的小 payload 可内联（BYTEA / 对象存储由上层决定）
ARTIFACT_INLINE_THRESHOLD_BYTES=16384
# 超过该字节数且 zstd 后更小才启用压缩
ARTIFACT_COMPRESSION_THRESHOLD_BYTES=16384
# zstd 压缩级别（zstandard 库安全范围）
ARTIFACT_ZSTD_LEVEL=6
# 对象硬上限（防压缩炸弹；读取时也校验）
ARTIFACT_MAX_OBJECT_BYTES=67108864
# 读取/verify 时校验 SHA 与 size
ARTIFACT_VERIFY_ON_READ=true

# ---- V2 Artifact S3 Driver（WP-00c2）----
# 凭据只走标准 provider chain（IAM role / workload identity / 服务端 secret injection）。
# 禁止在此写入云厂商 access key / 明文 secret / key-like 示例。
# ARTIFACT_DRIVER=s3 时 bucket 与 region 必填；local 模式不要求本段配置
ARTIFACT_S3_BUCKET=
# 对象 key 前缀（可空；非空时禁止首尾 /、空段、.、..、反斜杠、NUL/CR/LF）
ARTIFACT_S3_PREFIX=v2-artifacts
ARTIFACT_S3_REGION=us-east-1
# 仅 S3-compatible 服务需要；必须是绝对 http(s)://host[:port] origin（无 userinfo/query/路径）。
# http:// 还必须显式设置 ARTIFACT_S3_ALLOW_INSECURE_HTTP=true
ARTIFACT_S3_ENDPOINT_URL=
# addressing style：auto | virtual | path
ARTIFACT_S3_ADDRESSING_STYLE=auto
ARTIFACT_S3_CONNECT_TIMEOUT_S=2
ARTIFACT_S3_READ_TIMEOUT_S=10
ARTIFACT_S3_MAX_POOL_CONNECTIONS=20
ARTIFACT_S3_MAX_ATTEMPTS=3
ARTIFACT_S3_EXPECTED_BUCKET_OWNER=
ARTIFACT_S3_ALLOW_INSECURE_HTTP=false

# ===========================
# V2 技术可观测性（WP-00d1）
# ===========================
# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）；JSON 单行对象（本地/测试可关）
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
OBS_SERVICE_NAME=pollymarket-v2
OBS_SERVICE_VERSION=dev
# 低基数 Prometheus 指标开关
PROMETHEUS_ENABLED=true
# OTel Trace：默认关闭（零网络 exporter）。启用时 endpoint 必填，必须绝对 http(s) origin，
# 允许空路径、/ 或 /v1/traces；http:// 还需 OTEL_ALLOW_INSECURE_HTTP=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ALLOW_INSECURE_HTTP=false
# 技术 Trace 采样比例（0.0..1.0）；execution/ledger/reconciliation 无父 span 仍 100% 采样
OTEL_TRACE_SAMPLE_RATIO=0.05
# OTLP exporter 导出超时（秒，>0）
OTEL_EXPORT_TIMEOUT_S=5
# V2 Runtime 健康探测超时（秒，>0）
RUNTIME_HEALTH_TIMEOUT_S=2.0

# ===========================
# V2 Polygon / Relayer（WP-06；fake-only，激活前留空）
# ===========================
# 真实 Polygon RPC 节点 URL（逗号分隔，≥3 个 finalized 一致性节点）；留空 = fake-only
PM_V2_POLYGON_RPC_URLS=
PM_V2_POLYGON_CHAIN_ID=137
PM_V2_POLYGON_FINALIZED_TAG=finalized
# Relayer-v2 Deposit Wallet 端点（fake-only）
PM_V2_RELAYER_BASE_URL=
PM_V2_RELAYER_NONCE_TIMEOUT_S=5.0
PM_V2_RELAYER_SUBMIT_TIMEOUT_S=15.0
PM_V2_RELAYER_STATUS_TIMEOUT_S=5.0
PM_V2_RELAYER_DEADLINE_TTL_S=600
# Registry exact 复核：启动与每次 chain operation 前
PM_V2_CONTRACT_REGISTRY_VERSION=polygon-mainnet-v1
PM_V2_CONTRACT_REGISTRY_SNAPSHOT_BLOCK=91842167
PM_V2_CHAIN_RECOVERY_LIMIT=200

# ===========================
# Redis 缓存（Base legacy）
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# Token 认证
# ===========================
# access_token 有效期（秒，默认 2 小时）
TOKEN_EXPIRES_IN=7200
# refresh_token 有效期（秒，默认 7 天）
REFRESH_TOKEN_EXPIRES_IN=604800
