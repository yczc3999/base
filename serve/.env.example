# ===========================
# 应用配置
# ===========================
APP_NAME=base
APP_DEBUG=false

# ===========================
# 服务配置
# ===========================
PORT=3000
# PM2 工作进程数（0=自动取CPU核心数，具体数字=固定进程数）
WORKERS=0

# ===========================
# PostgreSQL 数据库
# ===========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=base
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

# ===========================
# Redis 缓存
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# JWT 认证
# ===========================
JWT_SECRET=
JWT_EXPIRES_IN=7d
SSO_ENABLED=false
