{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://base-platform.local/schemas/base-upgrade-batch.schema.json",
  "title": "Base Upgrade Campaign Batch",
  "description": "Deterministic batch of single-project Base upgrade results. Cross-record campaign, target, ordering, and registry associations are enforced by the campaign runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "target_version",
    "results"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "target_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "base-upgrade-result.schema.json"
      }
    }
  }
}
